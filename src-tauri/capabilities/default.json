{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the interface is allowed to ask the system for, beyond the engine's own commands. Folder browsing is not here: it goes through the engine's list_directory and create_directory, so the window needs no file system access of its own.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "ms-settings:developers" },
        { "url": "http://127.0.0.1:[0-9]/" },
        { "url": "http://127.0.0.1:[0-9][0-9]/" },
        { "url": "http://127.0.0.1:[0-9][0-9][0-9]/" },
        { "url": "http://127.0.0.1:[0-9][0-9][0-9][0-9]/" },
        { "url": "http://127.0.0.1:[0-9][0-9][0-9][0-9][0-9]/" }
      ]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
